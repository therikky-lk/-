#!/bin/bash
# DB Browser for SQLite 3.13.1 — установка для Astra Linux (1.7 / 1.8) и Fedora
# Запуск:            bash install.sh
# Удаление:          bash install.sh --remove
#
# Права root не нужны, в систему ничего не ставится: всё кладётся в домашнюю папку.
# Программа берётся из официального релиза:
#   https://github.com/sqlitebrowser/sqlitebrowser/releases/tag/v3.13.1
# Ей нужна GLIBC 2.30+. В Astra 1.7 стоит 2.28, поэтому там новая glibc 2.36
# распаковывается в ~/glibc (НЕ устанавливается в систему) и программа
# запускается через неё. В Fedora и Astra 1.8 программа запускается напрямую.

VER=3.13.1
FILE=DB.Browser.for.SQLite-v$VER-x86.64-v2.AppImage
URL=https://github.com/sqlitebrowser/sqlitebrowser/releases/download/v$VER/$FILE
SHA=c2fd0c27c84777747527e1b28deccc824bc88eeb47f36a9575bf1ba0a5a38453

APP=~/sqlitebrowser          # сюда распаковывается программа
GL=~/glibc                   # сюда (только для Astra 1.7) распаковывается glibc
MENU=~/.local/share/applications
BIN=~/.local/bin

# Папка «Загрузки»
DL=$(xdg-user-dir DOWNLOAD 2>/dev/null)
[ -n "$DL" ] && [ "$DL" != "$HOME" ] || DL=~/Загрузки
[ -d "$DL" ] || { [ -d ~/Downloads ] && DL=~/Downloads; }

# Папка рабочего стола (в Astra Fly это ~/Desktops/Desktop1)
if [ -d ~/Desktops/Desktop1 ]; then
  DESK=~/Desktops/Desktop1
else
  DESK=$(xdg-user-dir DESKTOP 2>/dev/null)
  [ -n "$DESK" ] && [ "$DESK" != "$HOME" ] || DESK=~/Desktop
fi

# ---------- Удаление ----------
if [ "$1" = "--remove" ]; then
  rm -rf "$APP"
  rm -f "$MENU/sqlitebrowser.desktop" "$DESK/sqlitebrowser.desktop" "$BIN/sqlitebrowser"
  rm -f "$DL/$FILE"
  echo "DB Browser for SQLite удалён."
  echo "Папка $GL оставлена (её могут использовать другие программы)."
  echo "Если она не нужна: rm -rf $GL"
  exit 0
fi

if [ "$(uname -m)" != "x86_64" ]; then
  echo "ОШИБКА: этот скрипт только для 64-битных компьютеров (x86_64)."
  exit 1
fi

mkdir -p "$DL" "$APP" "$MENU" "$BIN" "$DESK"
cd "$DL" || exit 1

# Скачать файл, если его ещё нет в «Загрузках»
get() {
  [ -s "$2" ] && return 0
  echo "Скачиваю $2 ..."
  if command -v wget >/dev/null; then
    wget -q --show-progress -T 30 -O "$2" "$1"
  else
    curl -fL --connect-timeout 30 -o "$2" "$1"
  fi
  if [ $? -ne 0 ] || [ ! -s "$2" ]; then
    rm -f "$2"
    echo "ОШИБКА: не удалось скачать $2"
    echo "Скачайте его в браузере по ссылке и положите в папку $DL:"
    echo "  $1"
    echo "Потом запустите скрипт ещё раз."
    return 1
  fi
}

# ---------- 1. Скачать программу ----------
get "$URL" "$FILE" || exit 1
if command -v sha256sum >/dev/null; then
  if [ "$(sha256sum "$FILE" | cut -d' ' -f1)" != "$SHA" ]; then
    echo "ОШИБКА: файл $FILE скачался повреждённым. Удаляю его, запустите скрипт ещё раз."
    rm -f "$FILE"
    exit 1
  fi
  echo "Файл проверен (SHA256 совпадает)."
fi

# ---------- 2. Распаковать AppImage (FUSE не нужен) ----------
DIR=$APP/$VER
if [ ! -x "$DIR/usr/bin/sqlitebrowser" ]; then
  echo "Распаковываю программу ..."
  TMP=$(mktemp -d "$APP/tmp.XXXXXX") || exit 1
  cp "$FILE" "$TMP/app.AppImage" && chmod +x "$TMP/app.AppImage"
  ( cd "$TMP" && ./app.AppImage --appimage-extract >/dev/null 2>&1 )
  if [ ! -d "$TMP/squashfs-root/usr" ] && command -v unsquashfs >/dev/null; then
    # Запасной путь: достать образ через unsquashfs (если запуск AppImage запрещён)
    f=$TMP/app.AppImage
    shoff=$(od -An -t u8 -j 40 -N 8 "$f" | tr -d ' ')
    es=$(od -An -t u2 -j 58 -N 2 "$f" | tr -d ' ')
    en=$(od -An -t u2 -j 60 -N 2 "$f" | tr -d ' ')
    unsquashfs -q -o $((shoff + es * en)) -d "$TMP/squashfs-root" "$f" >/dev/null 2>&1
  fi
  if [ ! -x "$TMP/squashfs-root/usr/bin/sqlitebrowser" ]; then
    rm -rf "$TMP"
    echo "ОШИБКА: не удалось распаковать $FILE."
    echo "Установите squashfs-tools и запустите скрипт ещё раз:"
    echo "  Astra:  sudo apt install squashfs-tools"
    echo "  Fedora: sudo dnf install squashfs-tools"
    exit 1
  fi
  rm -rf "$DIR"
  mv "$TMP/squashfs-root" "$DIR"
  rm -rf "$TMP"
fi
echo "Программа распакована: $DIR"

# ---------- 3. Нужна ли своя glibc ----------
GV=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
[ -n "$GV" ] || GV=$(ldd --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+$')
NEED_GL=0
if [ -n "$GV" ] && [ "$(printf '%s\n' 2.30 "$GV" | sort -V | head -1)" != "2.30" ]; then
  NEED_GL=1
fi
echo "Системная glibc: ${GV:-неизвестно}"

if [ $NEED_GL = 1 ] && [ ! -f "$GL/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" ]; then
  # glibc 2.36 из Debian 12 (только распаковка, в систему не ставится)
  DEB=$(ls libc6_2.3[6-9]-*_amd64.deb 2>/dev/null | sort -V | tail -1)
  if [ -z "$DEB" ]; then
    DEB=libc6_2.36-9+deb12u14_amd64.deb
    get "https://mirror.yandex.ru/debian/pool/main/g/glibc/$DEB" "$DEB" || {
      echo "Если ссылка не работает, возьмите файл libc6_2.36-9+deb12u..._amd64.deb"
      echo "с самой большой цифрой тут: https://mirror.yandex.ru/debian/pool/main/g/glibc/"
      echo "положите в $DL и запустите скрипт ещё раз."
      exit 1
    }
  fi
  mkdir -p "$GL"
  dpkg-deb -x "$DEB" "$GL" || exit 1
fi
[ $NEED_GL = 1 ] && echo "glibc готова: $GL"

# ---------- 4. Запускатель ----------
cat > "$APP/run.sh" << EOF
#!/bin/bash
# Запуск DB Browser for SQLite $VER
D="$DIR/usr"
export QT_PLUGIN_PATH="\$D/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="\$D/plugins/platforms"
EOF
if [ $NEED_GL = 1 ]; then
  cat >> "$APP/run.sh" << 'EOF'
G=~/glibc/lib/x86_64-linux-gnu
[ -d ~/glibc/usr/lib/x86_64-linux-gnu/gconv ] && export GCONV_PATH=~/glibc/usr/lib/x86_64-linux-gnu/gconv
exec "$G/ld-linux-x86-64.so.2" --library-path "$D/lib:$G:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu" \
  "$D/bin/sqlitebrowser" "$@" 2>> ~/sqlitebrowser/sqlitebrowser.log
EOF
else
  cat >> "$APP/run.sh" << 'EOF'
exec "$D/bin/sqlitebrowser" "$@" 2>> ~/sqlitebrowser/sqlitebrowser.log
EOF
fi
chmod +x "$APP/run.sh"
ln -sf "$APP/run.sh" "$BIN/sqlitebrowser"

# ---------- 5. Значок в меню и на рабочем столе ----------
cp "$DIR/sqlitebrowser.svg" "$APP/sqlitebrowser.svg" 2>/dev/null
cat > "$MENU/sqlitebrowser.desktop" << EOF
[Desktop Entry]
Type=Application
Name=DB Browser for SQLite
Name[ru]=DB Browser for SQLite
Comment=Graphical editor for SQLite databases
Comment[ru]=Графический редактор баз данных SQLite
Exec=/bin/bash $APP/run.sh %f
Icon=$APP/sqlitebrowser.svg
Terminal=false
Categories=Development;Utility;Database;
MimeType=application/vnd.db4s-project+xml;application/x-sqlite3;application/vnd.sqlite3;application/x-sqlite2;application/geopackage+sqlite3;
StartupWMClass=sqlitebrowser
EOF
chmod +x "$MENU/sqlitebrowser.desktop"
cp "$MENU/sqlitebrowser.desktop" "$DESK/sqlitebrowser.desktop"
chmod +x "$DESK/sqlitebrowser.desktop"
# GNOME (Fedora): разрешить запуск значка с рабочего стола
command -v gio >/dev/null && gio set "$DESK/sqlitebrowser.desktop" metadata::trusted true 2>/dev/null
command -v update-desktop-database >/dev/null && update-desktop-database "$MENU" 2>/dev/null

echo
echo "Готово: DB Browser for SQLite $VER"
echo "Значок — на рабочем столе и в меню «Пуск» (раздел «Разработка»)."
echo "Из терминала: bash $APP/run.sh   (или sqlitebrowser, если ~/.local/bin есть в PATH)"
echo "Если значка не видно: правый клик по рабочему столу → «Обновить»."
echo "Если программа не открывается — пришлите файл $APP/sqlitebrowser.log"
